guardConn(clickBtn.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not isDragging then
        isDragging = true
        dragInputObject = input
        userMoved = false
        startInputPos = Vector2.new(input.Position.X, input.Position.Y)
        startFramePos = Frame.Position
    end
end))

guardConn(UserInputService.InputChanged:Connect(function(input)
    if not isDragging then return end
    if input == dragInputObject then
        local currentPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = currentPos - startInputPos
        
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
            userMoved = true
        end

        Frame.Position = UDim2.new(
            startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
            startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y
        )
    end
end))

guardConn(UserInputService.InputEnded:Connect(function(input)
    if isDragging and input == dragInputObject then
        isDragging = false
        dragInputObject = nil
        
        if not userMoved then
            interfaceState.Enabled = not interfaceState.Enabled
            render(false)
            UpdateAntiHitState(interfaceState.Enabled)
        end
        startInputPos = nil
        startFramePos = nil
    end
end))

