local function randName()
    local t = {}
    for i = 1, math.random(10, 16) do
        t[i] = string.char(math.random(97, 122))
    end
    return table.concat(t)
end

local function newInst(class, parent, props)
    local inst = Instance.new(class)
    inst.Name = randName()
    if props then
        for k, v in pairs(props) do inst[k] = v end
    end
    inst.Parent = parent
    return inst
end

local function tween(obj, dur, props, style)
    local ok, tw = pcall(TweenService.Create, TweenService, obj,
        TweenInfo.new(dur, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    if ok and tw then tw:Play() end
end

