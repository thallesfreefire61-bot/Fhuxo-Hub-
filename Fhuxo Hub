local state = { Active = false, FlashRequest = nil, FlashUntil = 0 }

local function accentColor()
    return interfaceState.Enabled and COL.AccentA or COL.Off
end

local function render(instant)
    local duration = instant and 0 or 0.28

    if interfaceState.Enabled then
        UIGradient2.Color = ColorSequence.new(COL.AccentA, COL.AccentB)
        UIGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, COL.Stroke),
            ColorSequenceKeypoint.new(0.45, COL.AccentA),
            ColorSequenceKeypoint.new(0.55, COL.AccentB),
            ColorSequenceKeypoint.new(1, COL.Stroke),
        })
        tween(Frame4, duration, { Position = UDim2.new(1, -(KNOB + 4), 0.5, 0) }, Enum.EasingStyle.Back)
        tween(UIStroke, 0.3, { Transparency = 0 })
    else
        UIGradient2.Color = ColorSequence.new(COL.Off, COL.Off)
        UIGradient.Color = ColorSequence.new(COL.Stroke, COL.Stroke)
        tween(Frame4, duration, { Position = UDim2.new(0, 4, 0.5, 0) }, Enum.EasingStyle.Back)
        tween(UIStroke, 0.3, { Transparency = 0.2 })
    end

    if state.FlashUntil <= os.clock() then
        tween(UIStroke2, duration, { Color = accentColor() })
    end
end

local function processFlash()
    local req = state.FlashRequest
    if not req then return end
    state.FlashRequest = nil
    state.FlashUntil = os.clock() + (req.Hold or 0)
    tween(UIStroke2, 0.2, { Color = req.Color })

    if req.Hold then
        task.delay(req.Hold, function()
            if os.clock() >= state.FlashUntil then
                tween(UIStroke2, 0.3, { Color = accentColor() })
            end
        end)
    end
end

