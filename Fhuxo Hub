local function isShown(element)
    while element do
        if element:IsA("GuiObject") and not element.Visible then return false end
        if element:IsA("LayerCollector") then return element.Enabled end
        element = element.Parent
    end
    return false
end

local function getGuiInsetY()
    local ok, r = pcall(function() return GuiService:GetGuiInset().Y end)
    return ok and r or 0
end

local function findTopButtonY(inst)
    local best = nil
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("GuiButton") and d.Visible and d.AbsoluteSize.Y > 8 and d.AbsoluteSize.X > 8 then
            local y = d.AbsolutePosition.Y
            if not best or y < best then best = y end
        end
    end
    return best or inst.AbsolutePosition.Y
end

local topContainerNames = {
    Hotbar = true, HotBar = true, Toolbar = true, ToolBar = true,
    Backpack = true, Inventory = true,
}

local topContainers = {}
local function scanTopContainers()
    table.clear(topContainers)
    local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return end
    for _, d in ipairs(playerGui:GetDescendants()) do
        if d:IsA("GuiObject") and topContainerNames[d.Name] then
            topContainers[#topContainers + 1] = d
        end
    end
end

local function getAllBars()
    local elements = {}
    pcall(function()
        if not StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) then return end
        for _, c in ipairs(CoreGui.RobloxGui.Backpack:GetChildren()) do
            if c:IsA("GuiObject") then elements[#elements + 1] = c end
        end
    end)
    for _, v in ipairs(topContainers) do
        if v.Parent then elements[#elements + 1] = v end
    end
    return elements
end

local function autoReposition()
    if isDragging or userMoved then
        manualPositionSet = true
        return
    end
    if manualPositionSet then return end

    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    if viewport.X < 10 or viewport.Y < 10 then return end

    local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local scaleFactor = math.min(viewport.X / 1280, viewport.Y / 720)
    local scale = isTouch and math.clamp(scaleFactor * 1.05, 0.6, 0.8) * 0.97 or math.clamp(scaleFactor, 0.8, 1.1)
    UIScale2.Scale = scale

    local backgroundTransparency = isTouch and 0.3 or 0
    if Frame2.BackgroundTransparency ~= backgroundTransparency then
        Frame2.BackgroundTransparency = backgroundTransparency
        Frame3.BackgroundTransparency = backgroundTransparency
    end

    local baseY = viewport.Y - 8 * scale
    local found = false

    for _, bar in ipairs(getAllBars()) do
        if isShown(bar) then
            local size = bar.AbsoluteSize
            local yPos = bar.AbsolutePosition.Y
            if size.X > 20 and size.Y > 20 and size.Y < viewport.Y * 0.4 and yPos + size.Y / 2 > viewport.Y * 0.5 then
                local topY = findTopButtonY(bar)
                found = true
                baseY = math.min(baseY, topY + getGuiInsetY())
            end
        end
    end

    if found then
        lastOffsetY = viewport.Y - baseY
    elseif lastOffsetY then
        baseY = viewport.Y - lastOffsetY
    end

    local finalY = math.max(baseY - (isTouch and 4 or 6) * scale - baseHeight * scale / 2, baseHeight * scale / 2 + 8)
    Frame.Position = UDim2.new(0.5, 0, 0, finalY)
end

local timeAcc1, timeAcc2 = 0, 0
guardConn(RunService.RenderStepped:Connect(function(dt)
    processFlash()
    timeAcc1 += dt
    timeAcc2 += dt

    if timeAcc1 >= 3 then
        timeAcc1 = 0
        pcall(scanTopContainers)
    end
    if timeAcc2 >= 0.2 then
        timeAcc2 = 0
        pcall(autoReposition)
    end

    if interfaceState.Enabled then
        rotationAngle = (rotationAngle + dt * (state.Active and 360 or 90)) % 360
        UIGradient.Rotation = rotationAngle
    end
end))

